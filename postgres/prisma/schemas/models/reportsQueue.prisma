model ReportsQueue {
  queuePosition             Int                     @default(autoincrement())
  queueItemId               Int                     @id  @default(autoincrement())
  userId                    String                  
  index                     Int?                    @db.SmallInt
  dateFrom                  String                  @db.VarChar(10)
  dateTo                    String                  @db.VarChar(10)
  failedCount               Int                     @db.SmallInt  @default(0)
  isEmptyPeriod             Boolean                 @default(false)

  reportLoadingState        ReportLoadingState      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, dateFrom, dateTo])
  @@index([userId, dateFrom, dateTo])

}